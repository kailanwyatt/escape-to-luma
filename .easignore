# EAS uses this file instead of .gitignore. Keep the shared exclusions below.
# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# web test zip
aperture-web-test.zip
*.zip

# Local planning, tests and tooling (not runtime). Non-runtime archives
# live in sibling ../escape-to-lume-unused/
/tests/
/scripts/
/.github/
/.claude/
/.codex/
/.agents/
/coverage/
/output/
/tmp/
**/*.md

# Local credentials, reports and build artifacts.
.env
.env.*
credentials.json
*.log
*.ipa
*.apk
*.aab
*.xcarchive
*.xcresult

# App.tsx, src/, runtime art/audio, app.json, eas.json, tsconfig and the npm
# lockfile must remain included. Native projects are generated by EAS.
