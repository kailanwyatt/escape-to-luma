# EAS upload ignore list.
# When .easignore exists, EAS uses it instead of .gitignore for the archive.
# Keep shared exclusions here AND omit non-runtime marketing / tooling weight.
# Docs: https://docs.expo.dev/build-reference/easignore/

# dependencies
node_modules/

# Expo / web output
.expo/
dist/
web-build/
expo-env.d.ts

# Native (generated locally; EAS generates its own)
.kotlin/
/ios
/android
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# typescript
*.tsbuildinfo

# archives / installers
aperture-web-test.zip
*.zip
*.ipa
*.apk
*.aab
*.xcarchive
*.xcresult
*.log

# secrets / credentials (never upload)
.env
.env.*
!.env.example
credentials.json
auth.json
.secrets/
secrets/
ios/certs/
**/GoogleService-Info.plist
**/google-services.json

# Local planning, tests, and tooling (not runtime)
/tests/
/scripts/
/.github/
/.claude/
/.codex/
/.agents/
/.cursor/
/coverage/
/output/
/tmp/
**/*.md

# Marketing / App Store creatives (not shipped in the binary)
# IMPORTANT: only the top-level /design folder — keep src/design/ (UI kit).
/design/
/null-creature-concept.png
/obs.md

# Scratch / unused promo art under assets (not referenced by require())
/assets/spark-opaque-ground-lower-third.png
/assets/spark-light-trail-lower-third.png
/assets/art/landing-hero.jpg
/assets/favicon-16.png
/assets/favicon-32.png

# App.tsx, src/, runtime assets (art/sfx/icons), app.json, eas.json,
# package.json, package-lock.json, tsconfig, index.ts must remain included.
