{
  "expo": {
    "name": "SPARK",
    "slug": "escape-to-luma",
    "owner": "suiteplugins",
    "version": "0.1.0",
    "scheme": "spark",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050B15",
    "ios": {
      "bundleIdentifier": "com.kurt.sparkescapetoluma",
      "buildNumber": "4",
      "supportsTablet": true,
      "requireFullScreen": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "GCSupportsGameMode": true,
        "LSApplicationCategoryType": "public.app-category.games"
      }
    },
    "android": {
      "icon": "./assets/android-icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#050B15",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.kurt.sparkescapetoluma"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "experiments": {
      "baseUrl": "/game2"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050B15",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#050B15",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "06bd8d18-81fe-4e5a-bcfe-c7f46d834c98"
      },
      "admob": {
        "iosAppId": "ca-app-pub-1715335515944327~5238132731",
        "androidAppId": "ca-app-pub-1715335515944327~9693302939",
        "iosRewardedUnitId": "ca-app-pub-1715335515944327/4154035794",
        "androidRewardedUnitId": "ca-app-pub-1715335515944327/1914974559",
        "iosInterstitialUnitId": "ca-app-pub-1715335515944327/5038822187",
        "androidInterstitialUnitId": "ca-app-pub-1715335515944327/8380221265"
      }
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-1715335515944327~9693302939",
    "ios_app_id": "ca-app-pub-1715335515944327~5238132731"
  }
}
